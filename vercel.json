{
  "version": 2,
  "buildCommand": "npm install && npx prisma generate && npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/auth/login",               "destination": "/api/auth/login" },
    { "source": "/api/auth/register",            "destination": "/api/auth/register" },
    { "source": "/api/auth/me",                  "destination": "/api/auth/me" },
    { "source": "/api/cars/categories",          "destination": "/api/cars/categories" },
    { "source": "/api/cars/:id",                 "destination": "/api/cars/[id]" },
    { "source": "/api/cars",                     "destination": "/api/cars/index" },
    { "source": "/api/cart/count",               "destination": "/api/cart/count" },
    { "source": "/api/cart/:carId",              "destination": "/api/cart/[carId]" },
    { "source": "/api/cart",                     "destination": "/api/cart/index" },
    { "source": "/api/orders/track/:orderNumber","destination": "/api/orders/track/[orderNumber]" },
    { "source": "/api/orders/my",                "destination": "/api/orders/my" },
    { "source": "/api/orders/:id",               "destination": "/api/orders/[id]" },
    { "source": "/api/orders",                   "destination": "/api/orders/index" },
    { "source": "/api/simulation",               "destination": "/api/simulation/index" },
    { "source": "/api/admin/stats",              "destination": "/api/admin/stats" },
    { "source": "/api/admin/clients",            "destination": "/api/admin/clients" },
    { "source": "/api/user/profile",             "destination": "/api/user/profile" },
    { "source": "/api/user/password",            "destination": "/api/user/password" },
    { "source": "/api",                          "destination": "/api/index" },
    { "source": "/(.*)",                         "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin",      "value": "https://autokompetenz.vercel.app" },
        { "key": "Access-Control-Allow-Methods",     "value": "GET,POST,PUT,PATCH,DELETE,OPTIONS" },
        { "key": "Access-Control-Allow-Headers",     "value": "Content-Type,Authorization" },
        { "key": "Access-Control-Allow-Credentials", "value": "true" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
