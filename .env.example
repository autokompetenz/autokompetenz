# ── Supabase PostgreSQL ──────────────────────────────────────────────────
# Supabase → Settings → Database → Connection string → Transaction pooler
DATABASE_URL="postgresql://postgres.XXXXX:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Supabase → Settings → Database → Connection string → Direct connection
DIRECT_URL="postgresql://postgres.XXXXX:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

# ── JWT ──────────────────────────────────────────────────────────────────
JWT_SECRET="remplacer-par-64-caracteres-aleatoires-minimum"

# ── Gmail SMTP ───────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=autoKompetenz@gmail.com
SMTP_PASS=xxxx-xxxx-xxxx-xxxx
FROM_EMAIL=autoKompetenz@gmail.com
FROM_NAME=Auto Kompetenz GmbH
